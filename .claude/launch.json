{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pwa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "pwa",
        "run",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "sync",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "sync", "run", "dev", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "pwa-live",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd pwa && pnpm run build && SYNC_PROXY=https://sync.muchtoman.com pnpm exec vite preview --port 4175 --strictPort"],
      "port": 4175
    },
    {
      "name": "www",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "worker", "run", "dev", "--port", "8788", "--local-upstream", "muchtoman.com"],
      "port": 8788
    }
  ]
}
