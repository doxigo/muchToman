{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pwa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "pwa",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "sync",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "sync", "--", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "pwa-live",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd pwa && npm run build && SYNC_PROXY=https://sync.muchtoman.com npx vite preview --port 4175 --strictPort"],
      "port": 4175
    },
    {
      "name": "www",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8788",
        "-d",
        "worker/public"
      ],
      "port": 8788
    }
  ]
}
