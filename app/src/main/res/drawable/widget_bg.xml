<?xml version="1.0" encoding="utf-8"?>
<!-- The hero card in miniature: the same flat forest field, the card radius, and the hero's
     own hairline as an edge — so the widget reads as a piece of the app broken off onto the
     home screen, not a generic dark tile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#163300" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#24FFFFFF" />
</shape>
