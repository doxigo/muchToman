<?xml version="1.0" encoding="utf-8"?>
<!-- The hero field in miniature: same gradient with the light on the top corner, the card
     radius, and the hero's own hairline as an edge — so the widget reads as a piece of the
     app broken off onto the home screen, not a generic dark tile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:startColor="#1E4808"
        android:endColor="#112B03" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
