<?xml version="1.0" encoding="utf-8"?>
<!-- ImageViews, not TextViews: the launcher inflates this layout in its own process and
     cannot load another APK's font resources — every fontFamily here silently fell back to
     the system Naskh. The app renders each line into a bitmap with the real Modam instance
     (Widget.kt) and ships pixels, which no launcher can get wrong. fitCenter also scales a
     total that outgrows the cell instead of clipping «تومان» off the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="دارایی من" />

    <ImageView
        android:id="@+id/widget_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/widget_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />
</LinearLayout>
