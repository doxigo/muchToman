<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Both asked for together, and only when she switches bank messages on in settings. READ_SMS
        is the one that matters: everything the app knows comes from reading the message store.
        RECEIVE_SMS buys exactly one thing — SmsReceiver hears a message land and runs the ledger
        watch now instead of at the next six-hour tick, which is what makes «۸۰٪ رفته» arrive at
        the till rather than after dinner. The receiver stores nothing and parses nothing; it
        checks the sender and enqueues the same worker the schedule runs. Denied on its own, the
        six-hour sweep still covers everything, just later.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
        Asked for when she saves her first بودجه, or from دفتر once transactions are waiting to be
        filed — never at launch, which is the same rule READ_SMS follows. There are exactly two
        things the app will ever post, on two channels she can silence separately: a budget she set
        has crossed a line she asked to be told about, and a transaction has landed that nobody has
        said what it was. See Notify.kt.

        Denying it costs her nothing but the interruption: every budget still measures itself, the
        card on the آینده tab says the same thing that notification would have, and the badge on
        دفتر says the same thing the other one would have.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        READ_SMS is taken to mean "this app needs a radio", which would hide it from every
        tablet and Chromebook that has none. It does not: it reads the message store, and on a
        device with nothing in it the feature simply has nothing to show.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuchToman"
        android:usesCleartextTraffic="false">
        <!--
            Handle configuration changes rather than being destroyed by them. Everything she
            commits is already in the Store, but what is half-typed is not: rotating the phone
            with a wallet address pasted into the sheet threw the sheet and the address away.
            And it was not only rotation — the theme is SYSTEM by default, so the phone going
            dark at sunset, or a change of display font size, recreated the activity in exactly
            the same way. Recreation also runs onStop, which re-arms the lock, so anyone with
            the app lock on was asked for a fingerprint every time they turned the phone.

            Compose republishes LocalConfiguration on onConfigurationChanged, so the theme and
            the font scale still follow the system without the activity dying for it.

            ponytail: this does not survive process death or "Don't keep activities";
            rememberSaveable would. Not worth eight of them and a Saver for one sheet's text.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="muchtoman" android:host="join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="sync.muchtoman.com"
                    android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <!--
            SMS_RECEIVED is one of the implicit broadcasts the platform still delivers to a
            manifest receiver, app killed or not — which is the entire reason this is a receiver
            and not a longer-lived anything. Exported because the system must reach it;
            BROADCAST_SMS so *only* the system can — no other app can spoof a bank message at it.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TotalWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_total_info" />
        </receiver>
    </application>
</manifest>
