<?xml version="1.0" encoding="utf-8"?>
<!--
  The shortcut glyphs are the tab bar's own drawings (TabBar.kt), on its 24-unit canvas and in its
  one pen — 2 units, round caps and joins — scaled x2.2 into the adaptive icon's 108 and centred:
  (108 - 24 * 2.2) / 2 = 27.6. This one is PlusMark, the «+ تراکنش» pill's mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.2"
        android:scaleY="2.2"
        android:translateX="27.6"
        android:translateY="27.6">
        <path
            android:pathData="M12,5 V19 M5,12 H19"
            android:strokeColor="@color/ic_launcher_glyph"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
