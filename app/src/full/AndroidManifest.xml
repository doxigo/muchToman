<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher shortcuts, on the full edition only. Lite has one screen, the one its icon already
    opens, so a long-press there would offer nothing a tap does not.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
